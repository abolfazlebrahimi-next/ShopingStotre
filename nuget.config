<?xml version="1.0" encoding="utf-8"?>
<!--
  منبع بسته‌ها به‌صورت صریح روی nuget.org تنظیم شده است تا در هر ماشینی
  (ویندوز/لینوکس) دستور Restore بدون نیاز به تنظیمات کاربری کار کند.
  در صورت استفاده از فید داخلی سازمان، آن را به همین فایل اضافه کنید.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
