<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ShopingStore.Web</RootNamespace>
    <AssemblyName>ShopingStore.Web</AssemblyName>
    <UserSecretsId>shopstore-web-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- برای اجرای دستورهای dotnet ef migrations با این پروژه به‌عنوان startup -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopingStore.Domain\ShopingStore.Domain.csproj" />
    <ProjectReference Include="..\ShopingStore.Infrastructure\ShopingStore.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\img\products\" />
    <Folder Include="wwwroot\img\categories\" />
  </ItemGroup>

</Project>
