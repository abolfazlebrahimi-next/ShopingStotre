@page "/account/profile"
@model ShopingStore.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "اطلاعات حساب";
}

<div class="account-layout">
    <partial name="_AccountNav" />

    <div class="card">
        <h1 style="font-size:1.1rem">اطلاعات حساب کاربری</h1>

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-grid">
                <div class="form-row">
                    <label for="FullName">نام و نام خانوادگی</label>
                    <input id="FullName" name="fullName" value="@Model.Profile?.FullName" required maxlength="150" />
                </div>
                <div class="form-row">
                    <label for="PhoneNumber">شماره موبایل</label>
                    <input id="PhoneNumber" name="phoneNumber" value="@Model.Profile?.PhoneNumber" dir="ltr" maxlength="11" />
                </div>
                <div class="form-row">
                    <label for="NationalCode">کد ملی (اختیاری)</label>
                    <input id="NationalCode" name="nationalCode" value="@Model.Profile?.NationalCode" dir="ltr" maxlength="10" />
                </div>
                <div class="form-row">
                    <label>ایمیل (غیرقابل تغییر)</label>
                    <input value="@Model.Profile?.Email" disabled dir="ltr" />
                    <span class="hint">برای تغییر ایمیل با پشتیبانی تماس بگیرید.</span>
                </div>
            </div>
            <button type="submit" class="btn btn--primary">ذخیره تغییرات</button>
        </form>
    </div>
</div>
