@page "/product/{slug}"
@model ShopingStore.Web.Pages.Products.DetailsModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    ViewData["Description"] = product.ShortDescription;
}

<nav class="breadcrumb">
    <a href="/">خانه</a><span>/</span>
    <a href="/products">فروشگاه</a><span>/</span>
    <a href="/category/@product.CategorySlug">@product.CategoryName</a><span>/</span>
    <span>@product.Name</span>
</nav>

<div class="product-detail">
    <div class="gallery">
        <div class="gallery__main">
            <img data-gallery-main src="@product.Images[0]" alt="@product.Name" width="420" height="420" />
        </div>
        @if (product.Images.Count > 1)
        {
            <div class="gallery__thumbs">
                @foreach (var image in product.Images)
                {
                    <img data-gallery-thumb data-src="@image" src="@image" alt="@product.Name" class="@(image == product.Images[0] ? "is-active" : "")" />
                }
            </div>
        }
    </div>

    <div>
        <div class="buy-box">
            <h1 style="font-size:1.25rem">@product.Name</h1>

            <div class="flex mb-2">
                <span class="rating">★ @ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.Rating.ToString("0.0"))</span>
                <span class="muted">(@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.ReviewsCount.ToString()) نظر)</span>
                @if (product.Brand is not null)
                {
                    <span class="chip">برند: @product.Brand</span>
                }
                @if (product.IsNew)
                {
                    <span class="badge badge--new">جدید</span>
                }
            </div>

            <p class="muted">@product.ShortDescription</p>

            <ul class="summary-list mb-2">
                <li><span>قیمت کالا</span><span>@ShopingStore.Domain.Common.PersianDate.ToPrice(product.Price)</span></li>
                @if (product.HasDiscount)
                {
                    <li>
                        <span>تخفیف (@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.DiscountPercent.ToString())٪)</span>
                        <span style="color:var(--danger)">- @ShopingStore.Domain.Common.PersianDate.ToPrice(product.Price - product.EffectivePrice)</span>
                    </li>
                }
            </ul>

            <form action="/cart?handler=Add" method="post" data-ajax="cart" id="add-to-cart-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@product.Id" />

                @foreach (var variant in product.Variants)
                {
                    <div class="variant-group">
                        <strong style="font-size:.86rem">@variant.Name</strong>
                        <div class="variant-options">
                            @foreach (var option in variant.Options)
                            {
                                var value = $"{variant.Name}: {option}";
                                <label>
                                    <input type="radio" name="variant" value="@value" checked="@(option == variant.Options.First())" />
                                    <span>@option</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="form-row">
                    <label for="quantity">تعداد</label>
                    <div class="flex">
                        <input id="quantity" style="max-width:110px" type="number" name="quantity" value="1" min="1" max="@Math.Max(1, Math.Min(product.Stock, 10))" />
                        <span class="@(product.Stock > 0 ? "stock-pill" : "stock-pill stock-pill--out")">
                            @(product.Stock > 0 ? $"موجود در انبار ({ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.Stock.ToString())} عدد)" : "ناموجود")
                        </span>
                    </div>
                </div>

                <div class="flex-between mt-2">
                    <div>
                        @if (product.HasDiscount)
                        {
                            <span class="price--old">@ShopingStore.Domain.Common.PersianDate.ToPrice(product.Price, null)</span>
                        }
                        <span class="price" style="font-size:1.3rem">@ShopingStore.Domain.Common.PersianDate.ToPrice(product.EffectivePrice)</span>
                    </div>
                    <div class="flex">
                        <button type="button" class="wish-btn @(product.IsFavorite ? "is-active" : "")" data-wishlist="@product.Id" title="علاقه‌مندی">
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.3-9A5.4 5.4 0 0112 5.6 5.4 5.4 0 0121.3 12c-1.8 4.4-9.3 9-9.3 9z"/></svg>
                        </button>
                        <button type="submit" class="btn btn--primary" @(product.Stock <= 0 ? "disabled" : "")>افزودن به سبد خرید</button>
                    </div>
                </div>
            </form>

            <div class="flex mt-2 muted" style="font-size:.82rem">
                <span>🚚 ارسال سریع</span>
                <span>↩️ ۷ روز بازگشت</span>
                <span>🔒 پرداخت امن</span>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="tabs">
        <button type="button" class="is-active" data-tab="description">توضیحات</button>
        <button type="button" data-tab="specs">مشخصات فنی</button>
        <button type="button" data-tab="reviews">نظرات (@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.ReviewsCount.ToString()))</button>
    </div>

    <div class="tab-panel is-active" data-tab-panel="description">
        @Html.Raw(product.Description ?? "<p>توضیحی برای این محصول ثبت نشده است.</p>")
    </div>

    <div class="tab-panel" data-tab-panel="specs">
        @if (product.Specifications.Count == 0)
        {
            <p class="muted">مشخصات فنی برای این محصول ثبت نشده است.</p>
        }
        else
        {
            <table class="spec-table">
                <tbody>
                @foreach (var spec in product.Specifications)
                {
                    <tr>
                        <td>@spec.Name</td>
                        <td>@spec.Value</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div class="tab-panel" data-tab-panel="reviews">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" class="mb-3">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="form-row">
                        <label for="rating">امتیاز شما</label>
                        <select id="rating" name="rating">
                            <option value="5">★★★★★ عالی</option>
                            <option value="4">★★★★ خوب</option>
                            <option value="3">★★★ متوسط</option>
                            <option value="2">★★ ضعیف</option>
                            <option value="1">★ بد</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label for="title">عنوان نظر (اختیاری)</label>
                        <input id="title" name="title" maxlength="150" />
                    </div>
                </div>
                <div class="form-row">
                    <label for="comment">متن نظر</label>
                    <textarea id="comment" name="comment" required minlength="5"></textarea>
                </div>
                <button type="submit" class="btn btn--primary">ثبت نظر</button>
                <p class="hint">نظر شما پس از تأیید کارشناسان نمایش داده می‌شود.</p>
            </form>
        }
        else
        {
            <p class="muted">برای ثبت نظر <a href="/account/login?returnUrl=/product/@product.Slug">وارد حساب</a> شوید.</p>
        }

        @if (product.Reviews.Count == 0)
        {
            <p class="muted">هنوز نظری برای این محصول ثبت نشده است.</p>
        }
        else
        {
            foreach (var review in product.Reviews)
            {
                <div class="review">
                    <div class="review__head">
                        <span class="review__author">@review.AuthorName</span>
                        <span>
                            <span class="rating">@string.Concat(Enumerable.Repeat("★", review.Rating))</span>
                            @if (review.IsVerifiedPurchase)
                            {
                                <span class="verified">✓ خریدار این محصول</span>
                            }
                        </span>
                    </div>
                    @if (review.Title is not null)
                    {
                        <strong>@review.Title</strong>
                    }
                    <p style="margin:.2rem 0">@review.Comment</p>
                    <small class="muted">@ShopingStore.Domain.Common.PersianDate.ToRelative(review.CreatedAtUtc)</small>
                </div>
            }
        }
    </div>
</div>

@if (product.RelatedProducts.Count > 0)
{
    <section class="section mt-3">
        <div class="section__head">
            <h2>محصولات مشابه</h2>
        </div>
        <div class="product-grid">
            @foreach (var related in product.RelatedProducts)
            {
                <partial name="_ProductCard" model="related" />
            }
        </div>
    </section>
}
