@page "/admin/products"
@model ShopingStore.Web.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "مدیریت محصولات";
}

<div class="card mb-3">
    <form method="get" class="flex" style="flex-wrap:wrap">
        <input type="search" name="search" value="@Model.Query.Search" placeholder="جست‌وجوی نام محصول..." style="max-width:280px" />
        <select name="category" style="max-width:200px">
            <option value="">همه دسته‌ها</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Slug" selected="@(Model.Query.Category == category.Slug)">@category.Name</option>
            }
        </select>
        <select name="sortBy" style="max-width:180px">
            <option value="Newest">جدیدترین</option>
            <option value="Cheapest">ارزان‌ترین</option>
            <option value="MostExpensive">گران‌ترین</option>
            <option value="BestSelling">پرفروش‌ترین</option>
        </select>
        <button type="submit" class="btn btn--primary">فیلتر</button>
        <a href="/admin/products/edit" class="btn btn--success">➕ افزودن محصول</a>
    </form>
</div>

<div class="table-wrap">
    <table class="data">
        <thead>
        <tr>
            <th>تصویر</th><th>نام محصول</th><th>دسته‌بندی</th><th>قیمت</th><th>موجودی</th>
            <th>فروش</th><th>امتیاز</th><th>وضعیت</th><th>عملیات</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in Model.Products.Items)
        {
            <tr>
                <td><img src="@product.ImageUrl" alt="@product.Name" width="44" height="44" style="object-fit:contain" /></td>
                <td><a href="/product/@product.Slug" target="_blank">@product.Name</a></td>
                <td>@product.CategoryName</td>
                <td>@ShopingStore.Domain.Common.PersianDate.ToPrice(product.EffectivePrice)</td>
                <td>
                    @if (product.Stock <= 0)
                    {
                        <span class="status status--danger">ناموجود</span>
                    }
                    else
                    {
                        @ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.Stock.ToString())
                    }
                </td>
                <td>@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.ReviewsCount.ToString()) نظر</td>
                <td>★ @ShopingStore.Domain.Common.PersianDate.ToPersianDigits(product.Rating.ToString("0.0"))</td>
                <td>
                    @if (product.Stock > 0)
                    {
                        <span class="status status--success">فعال</span>
                    }
                    else
                    {
                        <span class="status status--secondary">غیرفعال</span>
                    }
                </td>
                <td>
                    <div class="flex">
                        <a class="btn btn--ghost btn--sm" href="/admin/products/edit/@product.Id">ویرایش</a>
                        <form method="post" asp-page-handler="Toggle" data-confirm="وضعیت نمایش این محصول تغییر کند؟">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="btn btn--ghost btn--sm">فعال/غیرفعال</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" data-confirm="این محصول حذف شود؟">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@product.Id" />
                            <button type="submit" class="btn btn--danger btn--sm">حذف</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Products.Items.Count == 0)
{
    <div class="card empty-state mt-3">
        <h3>محصولی یافت نشد</h3>
        <a class="btn btn--primary" href="/admin/products/edit">افزودن اولین محصول</a>
    </div>
}

<partial name="_Pagination" model="Model.Pagination" />
