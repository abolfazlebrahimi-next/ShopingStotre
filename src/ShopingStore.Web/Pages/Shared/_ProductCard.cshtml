@model ProductListItemDto
@{
    var card = Model;
}
<article class="product-card">
    <div class="product-card__media">
        <a href="/product/@card.Slug" aria-label="@card.Name">
            <img src="@card.ImageUrl" alt="@card.Name" loading="lazy" width="200" height="200" />
        </a>
        <div class="product-card__badges">
            @if (card.DiscountPercent > 0)
            {
                <span class="badge badge--discount">@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(card.DiscountPercent.ToString())٪ تخفیف</span>
            }
            @if (card.IsNew)
            {
                <span class="badge badge--new">جدید</span>
            }
            @if (card.Stock <= 0)
            {
                <span class="badge badge--out">ناموجود</span>
            }
        </div>
        <button type="button" class="wish-btn @(card.IsFavorite ? "is-active" : "")" data-wishlist="@card.Id" title="افزودن به علاقه‌مندی‌ها" aria-label="علاقه‌مندی">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 21s-7.5-4.6-9.3-9A5.4 5.4 0 0112 5.6 5.4 5.4 0 0121.3 12c-1.8 4.4-9.3 9-9.3 9z"/></svg>
        </button>
    </div>

    <div class="product-card__body">
        <a class="product-card__title" href="/product/@card.Slug">@card.Name</a>

        <div class="product-card__meta">
            <span class="rating" title="امتیاز @card.Rating">★ @ShopingStore.Domain.Common.PersianDate.ToPersianDigits(card.Rating.ToString("0.0"))</span>
            <span>@card.CategoryName</span>
        </div>

        <div class="product-card__price">
            @if (card.HasDiscount)
            {
                <span class="price--old">@ShopingStore.Domain.Common.PersianDate.ToPrice(card.Price, null)</span>
            }
            <span class="price">@ShopingStore.Domain.Common.PersianDate.ToPrice(card.EffectivePrice)</span>
        </div>

        <form action="/cart?handler=Add" method="post" data-ajax="cart" class="mt-1">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@card.Id" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn btn--primary btn--block btn--sm" @(card.Stock <= 0 ? "disabled" : "")>
                @(card.Stock <= 0 ? "ناموجود" : "افزودن به سبد خرید")
            </button>
        </form>
    </div>
</article>
