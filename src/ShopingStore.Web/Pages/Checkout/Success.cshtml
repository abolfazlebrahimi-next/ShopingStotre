@page "/order/success/{orderNumber}"
@model ShopingStore.Web.Pages.Checkout.SuccessModel
@{
    ViewData["Title"] = "سفارش با موفقیت ثبت شد";
    var order = Model.Order;
}

<div class="card text-center" style="max-width:720px;margin:2rem auto">
    <div style="font-size:3rem">✅</div>
    <h2>سفارش شما با موفقیت ثبت شد</h2>
    <p class="muted">
        شماره سفارش: <strong>@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(order.OrderNumber)</strong>
        — @ShopingStore.Domain.Common.PersianDate.ToPersianDateTime(order.CreatedAtUtc)
    </p>

    <div class="grid-2 mt-3" style="text-align:right">
        <div>
            <h3 style="font-size:.95rem">اطلاعات گیرنده</h3>
            <p class="muted" style="font-size:.86rem">
                @order.CustomerName<br />
                @ShopingStore.Domain.Common.PersianDate.ToPersianDigits(order.CustomerPhone)<br />
                @order.FullAddress
            </p>
        </div>
        <div>
            <h3 style="font-size:.95rem">وضعیت پرداخت</h3>
            <p class="muted" style="font-size:.86rem">
                <span class="status status--@order.Status.ToCssClass()">@order.Status.ToPersianTitle()</span><br />
                شیوه پرداخت: @order.PaymentMethod.ToPersianTitle()<br />
                @if (order.PaymentReference is not null)
                {
                    <span>شناسه پرداخت: @order.PaymentReference</span>
                }
            </p>
        </div>
    </div>

    <div class="table-wrap mt-2">
        <table class="data">
            <thead>
            <tr><th>کالا</th><th>تعداد</th><th>قیمت واحد</th><th>جمع</th></tr>
            </thead>
            <tbody>
            @foreach (var item in order.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@ShopingStore.Domain.Common.PersianDate.ToPersianDigits(item.Quantity.ToString())</td>
                    <td>@ShopingStore.Domain.Common.PersianDate.ToPrice(item.UnitPrice)</td>
                    <td>@ShopingStore.Domain.Common.PersianDate.ToPrice(item.LineTotal)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <ul class="summary-list mt-2" style="max-width:420px;margin-inline:auto">
        <li><span>جمع کالاها</span><span>@ShopingStore.Domain.Common.PersianDate.ToPrice(order.Subtotal)</span></li>
        @if (order.DiscountAmount > 0)
        {
            <li><span>تخفیف</span><span>- @ShopingStore.Domain.Common.PersianDate.ToPrice(order.DiscountAmount)</span></li>
        }
        <li><span>هزینه ارسال</span><span>@(order.ShippingCost == 0 ? "رایگان" : ShopingStore.Domain.Common.PersianDate.ToPrice(order.ShippingCost))</span></li>
        <li><span>مالیات</span><span>@ShopingStore.Domain.Common.PersianDate.ToPrice(order.TaxAmount)</span></li>
        <li class="total"><span>مبلغ کل</span><span>@ShopingStore.Domain.Common.PersianDate.ToPrice(order.Total)</span></li>
    </ul>

    <div class="flex" style="justify-content:center;margin-top:1.4rem">
        <a class="btn btn--primary" href="/account/orders/@order.Id">پیگیری سفارش</a>
        <a class="btn btn--ghost" href="/products">ادامه خرید</a>
    </div>
</div>
